# API mode (default)
MUAPI_API_KEY=your_muapi_key_here

# Content language (Whisper + titles/hooks/descriptions). Default: pt (Português Brasil)
CONTENT_LANGUAGE=pt

# Local mode (--mode local)
LLM_PROVIDER=openai           # openai or gemini
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto
LOCAL_OUTPUT_DIR=output
LOCAL_FACE_SMOOTHING=0.15     # face crop: 0=stable, 1=reactive (local mode)

# Clip start lead-in (seconds before first word). Prefer sentence end / short silence.
# CLIP_START_LEAD_IN=1.0
# CLIP_START_LEAD_IN_MIN=0.8
# CLIP_START_LEAD_IN_MAX=1.2

# YouTube upload (OAuth 2.0 — YouTube Data API v3)
# 1. Google Cloud Console → enable YouTube Data API v3
# 2. Create OAuth client (Desktop app) → copy Client ID / Secret
# 3. Run: python scripts/youtube_oauth.py
#    and paste the printed refresh token below
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here
YOUTUBE_PRIVACY_STATUS=private   # private | unlisted | public

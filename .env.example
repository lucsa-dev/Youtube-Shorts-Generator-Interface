# API mode (default)
MUAPI_API_KEY=your_muapi_key_here

# Content language (Whisper + titles/hooks/descriptions). Default: pt (Português Brasil)
CONTENT_LANGUAGE=pt

# Prefer YouTube captions (free) before Whisper. Set false to always run Whisper.
PREFER_YOUTUBE_CAPTIONS=true

# Local mode (--mode local)
LLM_PROVIDER=openai           # openai or gemini
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
# Thumbnails (cost): mini + medium + hybrid ≈ 10× cheaper than gpt-image-1 high
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_FIDELITY=low
THUMBNAIL_HYBRID=true
# frame = frame original do locutor + overlay local (sem fundo IA / sem remoção de fundo)
THUMBNAIL_MODE=frame
# Shared palette for thumbnail border + text (comma-separated hex)
# THUMBNAIL_PALETTE=#FF28B4,#FF7828,#FFDC28,#28DCFF,#A03CFF
# IMAGE_PROVIDER / GEMINI_IMAGE_* só importam se algum fluxo legado de imagem for reativado
IMAGE_PROVIDER=auto
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto
LOCAL_OUTPUT_DIR=output
LOCAL_FACE_SMOOTHING=0.15     # face crop: 0=stable, 1=reactive (local mode)
EVENTLAB_API_KEY=your_eventlabs_api_key_here

# Clip start lead-in (seconds before first word). Prefer sentence end / short silence.
# CLIP_START_LEAD_IN=1.0
# CLIP_START_LEAD_IN_MIN=0.8
# CLIP_START_LEAD_IN_MAX=1.2

# YouTube upload credentials are configured per project in the web UI
# (Projetos → Canal → Config). The CLI script below is still useful to
# obtain a refresh token that you paste into the project settings:
#   python scripts/youtube_oauth.py --client-id ... --client-secret ...
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
# YOUTUBE_PRIVACY_STATUS=private

